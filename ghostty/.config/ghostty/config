theme = nord
alpha-blending = native
background-opacity=0.9
# herdr launches on every new window/tab; if it ever exits (e.g. detach),
# drop into a login shell instead of closing so the window stays open and
# `herdr --remote <host>` can be run/detached from at any time.
command = /bin/zsh -l -c "herdr; exec /bin/zsh -l"
