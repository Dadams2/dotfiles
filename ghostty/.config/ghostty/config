theme = Catppuccin Frappe
alpha-blending = native
background-opacity=0.9
# macos-titlebar-style = hidden

# herdr launches on every new window/tab; if it ever exits (e.g. detach),
# drop into a login shell instead of closing so the window stays open and
# `herdr --remote <host>` can be run/detached from at any time.
# herdr launches on every new window/tab; if it ever exits (e.g. detach),
# drop into a login shell instead of closing so the window stays open and
# `herdr --remote <host>` can be run/detached from at any time.
command = /bin/zsh -l -c "herdr; exec /bin/zsh -l"

# Ghostty's built-in cmd+1..9 tab switching would otherwise eat these
# chords before herdr's own switch_tab binding ever sees them.
# currently a workaround from https://github.com/ghostty-org/ghostty/discussions/8756
keybind = command+digit_1=csi:49;9u
keybind = command+digit_2=csi:50;9u
keybind = command+digit_3=csi:51;9u
keybind = command+digit_4=csi:52;9u
keybind = command+digit_5=csi:53;9u
keybind = command+digit_6=csi:54;9u
keybind = command+digit_7=csi:55;9u
keybind = command+digit_8=csi:56;9u
keybind = command+digit_9=csi:57;9u
keybind = command+digit_0=csi:48;9u
